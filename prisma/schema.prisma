generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Restaurant {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  phone            String?
  address          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  restaurantEmail  String            @default("")
  coverImageUrl    String?
  cuisineType      String?
  customLink       String?
  description      String?
  facebook         String?
  instagram        String?
  logoUrl          String?
  tagline          String?
  themeColor       String?
  website          String?
  coverPublicId    String?
  logoPublicId     String?
  openingHours     Json?
  auditLogs        AuditLog[]
  categories       Category[]
  employees        Employee[]
  loyaltyCustomers LoyaltyCustomer[]
  loyaltyPrograms  LoyaltyProgram[]
  loyaltyRewards   LoyaltyReward[]
  menuItems        MenuItem[]
  orders           Order[]
  tables           RestaurantTable[]
}

model Employee {
  id            String         @id @default(cuid())
  restaurantId  String
  name          String
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  role          EmployeeRole   @default(OWNER)
  auditLogs     AuditLog[]
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([restaurantId, createdAt])
  @@index([restaurantId, role])
  @@index([restaurantId, isActive])
}

model Notification {
  id         String           @id @default(cuid())
  employeeId String
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  readAt     DateTime?
  data       Json?
  createdAt  DateTime         @default(now())
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([employeeId, isRead])
  @@index([type])
}

model AuditLog {
  id           String      @id @default(cuid())
  restaurantId String
  employeeId   String?
  action       AuditAction
  entity       String
  entityId     String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, action])
  @@index([restaurantId, employeeId])
  @@index([restaurantId])
}

model RestaurantTable {
  id           String      @id @default(cuid())
  restaurantId String
  name         String
  qrCode       String      @unique @default(uuid())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  status       TableStatus @default(AVAILABLE)
  orders       Order[]
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, createdAt])
}

model MenuItem {
  id             String      @id @default(cuid())
  restaurantId   String
  categoryId     String?
  name           String
  description    String?
  price          Decimal     @db.Decimal(10, 2)
  isAvailable    Boolean     @default(true)
  imageUrl       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  imagePublicId  String?
  foodType       FoodType    @default(VEG)
  imagePositionX Float       @default(0)
  imagePositionY Float       @default(0)
  imageScale     Float       @default(1)
  category       Category?   @relation(fields: [categoryId], references: [id])
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, isAvailable])
  @@index([restaurantId, categoryId])
}

model LoyaltyProgram {
  id                String   @id @default(cuid())
  restaurantId      String
  rewardName        String
  purchaseThreshold Int
  rewardQuantity    Int      @default(1)
  minimumOrderValue Decimal  @default(0) @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  restaurant       Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerPrograms LoyaltyCustomerProgram[]
  rewards          LoyaltyReward[]

  @@index([restaurantId])
  @@index([restaurantId, isActive])
}

model LoyaltyCustomer {
  id           String    @id @default(cuid())
  restaurantId String
  phone        String
  name         String?
  visitCount   Int       @default(0)
  totalSpend   Decimal   @default(0) @db.Decimal(10, 2)
  lastOrderAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant       Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerPrograms LoyaltyCustomerProgram[]
  rewards          LoyaltyReward[]
  orders           Order[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, phone])
}

model LoyaltyCustomerProgram {
  id            String   @id @default(cuid())
  customerId    String
  programId     String
  progressCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer LoyaltyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  program  LoyaltyProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([customerId, programId])
  @@index([customerId])
  @@index([programId])
}

model LoyaltyReward {
  id           String              @id @default(cuid())
  restaurantId String
  customerId   String
  programId    String?
  status       LoyaltyRewardStatus @default(AVAILABLE)
  orderId      String?
  createdAt    DateTime            @default(now())
  redeemedAt   DateTime?

  customer   LoyaltyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?          @relation(fields: [orderId], references: [id])
  program    LoyaltyProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, customerId, status])
  @@index([programId, status])
}

model Order {
  id                 String           @id @default(cuid())
  restaurantId       String
  tableId            String
  customerPhone      String?
  customerSessionId  String?
  customerId         String?
  total              Decimal          @db.Decimal(10, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  status             OrderStatus      @default(PENDING)
  loyaltyProcessed   Boolean          @default(false)

  rewards            LoyaltyReward[]
  customer           LoyaltyCustomer? @relation(fields: [customerId], references: [id])
  restaurant         Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table              RestaurantTable  @relation(fields: [tableId], references: [id])
  items              OrderItem[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([restaurantId, tableId])
  @@index([tableId, customerSessionId, status])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
}

enum EmployeeRole {
  OWNER
  MANAGER
  STAFF
}

enum NotificationType {
  NEW_ORDER
  ORDER_STATUS
  LOYALTY_REWARD
  EMPLOYEE_ACTIVITY
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  INACTIVE
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGED
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  EMPLOYEE_STATUS_CHANGED
  EMPLOYEE_DELETED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  MENU_CREATED
  MENU_UPDATED
  MENU_DELETED
  TABLE_CREATED
  TABLE_UPDATED
  TABLE_DELETED
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  SETTINGS_UPDATED
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED
}

enum LoyaltyRewardStatus {
  AVAILABLE
  REDEEMED
}
