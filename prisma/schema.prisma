generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum EmployeeRole {
  OWNER
  MANAGER
  STAFF
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  INACTIVE
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGED

  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  EMPLOYEE_STATUS_CHANGED
  EMPLOYEE_DELETED

  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED

  MENU_CREATED
  MENU_UPDATED
  MENU_DELETED

  TABLE_CREATED
  TABLE_UPDATED
  TABLE_DELETED

  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED

  SETTINGS_UPDATED
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum LoyaltyRewardStatus {
  AVAILABLE
  REDEEMED
}

model Restaurant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  phone           String?
  address         String?
  restaurantEmail String   @default("")

  // Branding
  logoUrl         String?
  logoPublicId    String?

  coverImageUrl   String?
  coverPublicId   String?

  // Profile
  tagline         String?
  description     String?
  cuisineType     String?

  // Social Links
  website         String?
  instagram       String?
  facebook        String?
  customLink      String?

  // Theme
  themeColor      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categories      Category[]
  employees       Employee[]
  auditLogs       AuditLog[]
  menuItems       MenuItem[]
  orders          Order[]
  tables          RestaurantTable[]
  loyaltyProgram  LoyaltyProgram?
  loyaltyCustomers LoyaltyCustomer[]
  loyaltyRewards  LoyaltyReward[]
}

model Employee {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  email        String     @unique
  passwordHash String
  role         EmployeeRole @default(OWNER)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@index([restaurantId, createdAt])
  @@index([restaurantId, role])
  @@index([restaurantId, isActive])
}

model AuditLog {
  id           String @id @default(cuid())

  restaurantId String
  employeeId   String?

  action AuditAction

  entity   String
  entityId String?

  metadata Json?

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, action])
  @@index([restaurantId, employeeId])
}

model RestaurantTable {
  id           String       @id @default(cuid())
  restaurantId String
  name         String
  qrCode       String       @unique @default(uuid())
  status       TableStatus  @default(AVAILABLE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orders       Order[]
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@unique([restaurantId, name])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@index([restaurantId, createdAt])
  @@unique([restaurantId, name])
}

model MenuItem {
  id           String      @id @default(cuid())
  restaurantId String
  categoryId   String?
  name         String
  description  String?
  price        Decimal     @db.Decimal(10, 2)
  foodType     FoodType    @default(VEG)
  isAvailable  Boolean     @default(true)
  imageUrl       String?
  imagePublicId  String?

  imageScale      Float @default(1)
  imagePositionX  Float @default(0)
  imagePositionY  Float @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  category     Category?   @relation(fields: [categoryId], references: [id])
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, isAvailable])
  @@index([restaurantId, categoryId])
}

model LoyaltyProgram {
  id               String   @id @default(cuid())
  restaurantId     String   @unique
  rewardName       String
  purchaseThreshold Int
  rewardQuantity   Int      @default(1)
  minimumOrderValue Decimal @db.Decimal(10, 2) @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customers        LoyaltyCustomer[]
  rewards          LoyaltyReward[]

  @@index([restaurantId, isActive])
}

model LoyaltyCustomer {
  id           String   @id @default(cuid())
  restaurantId String
  phone        String
  name         String?
  visitCount   Int      @default(0)
  totalSpend   Decimal  @db.Decimal(10, 2) @default(0)
  progressCount Int     @default(0)
  lastOrderAt  DateTime?
  programId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  program      LoyaltyProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  orders       Order[]
  rewards      LoyaltyReward[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, phone])
  @@index([restaurantId, progressCount])
}

model LoyaltyReward {
  id           String             @id @default(cuid())
  restaurantId String
  customerId   String
  programId    String
  status       LoyaltyRewardStatus @default(AVAILABLE)
  orderId      String?
  createdAt    DateTime           @default(now())
  redeemedAt   DateTime?
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     LoyaltyCustomer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  program      LoyaltyProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([restaurantId, customerId, status])
  @@index([programId, status])
}

model Order {
  id            String          @id @default(cuid())
  restaurantId  String
  tableId       String
  customerPhone String?
  customerId    String?
  status        OrderStatus     @default(PENDING)
  total         Decimal         @db.Decimal(10, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table         RestaurantTable @relation(fields: [tableId], references: [id])
  customer      LoyaltyCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  rewards       LoyaltyReward[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([restaurantId, tableId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
}
