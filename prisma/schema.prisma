generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum EmployeeRole {
  OWNER
  MANAGER
  STAFF
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  INACTIVE
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGED

  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  EMPLOYEE_STATUS_CHANGED
  EMPLOYEE_DELETED

  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED

  MENU_CREATED
  MENU_UPDATED
  MENU_DELETED

  TABLE_CREATED
  TABLE_UPDATED
  TABLE_DELETED

  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED

  SETTINGS_UPDATED
}

model Restaurant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  phone           String?
  address         String?
  restaurantEmail String   @default("")

  // Branding
  logoUrl         String?
  logoPublicId    String?

  coverImageUrl   String?
  coverPublicId   String?

  // Profile
  tagline         String?
  description     String?
  cuisineType     String?

  // Social Links
  website         String?
  instagram       String?
  facebook        String?
  customLink      String?

  // Theme
  themeColor      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categories      Category[]
  employees       Employee[]
  auditLogs       AuditLog[]
  menuItems       MenuItem[]
  orders          Order[]
  tables          RestaurantTable[]
}

model Employee {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  email        String     @unique
  passwordHash String
  role         EmployeeRole @default(OWNER)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@index([restaurantId, createdAt])
  @@index([restaurantId, role])
  @@index([restaurantId, isActive])
}

model AuditLog {
  id           String @id @default(cuid())

  restaurantId String
  employeeId   String?

  action AuditAction

  entity   String
  entityId String?

  metadata Json?

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, action])
  @@index([restaurantId, employeeId])
}

model RestaurantTable {
  id           String       @id @default(cuid())
  restaurantId String
  name         String
  qrCode       String       @unique @default(uuid())
  status       TableStatus  @default(AVAILABLE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orders       Order[]
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@index([restaurantId, createdAt])
  @@unique([restaurantId, name])
}

model MenuItem {
  id           String      @id @default(cuid())
  restaurantId String
  categoryId   String?
  name         String
  description  String?
  price        Decimal     @db.Decimal(10, 2)
  isAvailable  Boolean     @default(true)
  imageUrl     String?
  imagePublicId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  category     Category?   @relation(fields: [categoryId], references: [id])
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, isAvailable])
  @@index([restaurantId, categoryId])
}

model Order {
  id            String          @id @default(cuid())
  restaurantId  String
  tableId       String
  customerPhone String?
  status        String          @default("PENDING")
  total         Decimal         @db.Decimal(10, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table         RestaurantTable @relation(fields: [tableId], references: [id])
  items         OrderItem[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([restaurantId, tableId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
}
